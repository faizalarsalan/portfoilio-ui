    "      </div>",
    "",
    "      <div className=\"card-image-wrap\">",
    "        <img",
    "          src=\"https://plus.unsplash.com/premium_photo-1675249003499-0570ce14c7b4?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8c2hhcGV8ZW58MHx8MHx8fDA%3D\"",
    "          alt={name}",
    "        />",
    "      </div>",
    "",
    "      <div className=\"card-body\">",
    "        <h1>{name}</h1>",
    "        <p>{text}</p>",
    "      </div>",
    "",
    "      <div className=\"card-footer\">",
    "        <span className=\"price\">$129</span>",
    "        <button>View</button>",
    "      </div>",
    "    </div>",
    "  )",
    "}",
    "",
    "export default Card"
