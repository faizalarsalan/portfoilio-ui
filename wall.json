    "\"\"\"",
    "HyperFrames Video Generation & Rendering Engine",
    "Programmatically generates HTML+CSS+GSAP video compositions and compiles them to deterministic MP4.",
    "\"\"\"",
    "",
    "import os",
    "import sys",
    "import json",
    "import subprocess",
    "from pathlib import Path",
    "from typing import List, Dict, Any, Optional",
    "",
    "PROJECT_ROOT = Path(__file__).parent.parent.resolve()",
    "DEFAULT_BROWSER_PATH = r\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "DEFAULT_WHISPER_PATH = str(PROJECT_ROOT / \"bin\" / \"whisper-cli.exe\")",
    "DEFAULT_FFMPEG_DIR = r\"C:\\Users\\Faizt\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-9.1-full_build\\bin\"",
    "",
    "",
    "def get_hyperframes_env() -> Dict[str, str]:",
    "    \"\"\"Build process environment with required paths for Hyperframes and Chrome.\"\"\"",
    "    env = os.environ.copy()",
    "    bin_dir = str(PROJECT_ROOT / \"bin\")",
    "",
    "    # Ensure FFmpeg and project bin are in PATH",
    "    path_parts = [bin_dir, DEFAULT_FFMPEG_DIR, env.get(\"PATH\", \"\")]",
    "    env[\"PATH\"] = \";\".join(path_parts)",
    "    env[\"HYPERFRAMES_BROWSER_PATH\"] = DEFAULT_BROWSER_PATH",
    "    env[\"HYPERFRAMES_WHISPER_PATH\"] = DEFAULT_WHISPER_PATH",
    "    env[\"HYPERFRAMES_SKIP_SKILLS\"] = \"1\"",
    "    return env",
    "",
    "",
    "def create_composition(",
    "    comp_dir: str,",
    "    title: str,",
    "    duration: float = 10.0,",
    "    subtitles: Optional[List[Dict[str, Any]]] = None,",
    "    theme: str = \"dark\",",
    "    width: int = 1920,",
    "    height: int = 1080,",
    "    background_video: Optional[str] = None",
    ") -> str:",
    "    \"\"\"",
    "    Generate an HTML/GSAP composition directory ready for HyperFrames preview & rendering.",
    "",
    "    :param comp_dir: Target directory path",
    "    :param title: Video title text",
    "    :param duration: Total video duration in seconds",
    "    :param subtitles: List of subtitle segments [{'start': 0.0, 'end': 2.0, 'text': '...'}]",
    "    :param theme: Visual theme ('dark', 'cyberpunk', 'clean', 'gradient')",
    "    :param width: Resolution width",
    "    :param height: Resolution height",
    "    :param background_video: Optional relative or absolute path to a background video clip",
    "    :return: Absolute path to the composition directory",
    "    \"\"\"",
    "    comp_path = Path(comp_dir).resolve()",
    "    comp_path.mkdir(parents=True, exist_ok=True)",
    "",
    "    # Subtitle timeline animation generator",
    "    sub_spans_html = []",
    "    gsap_animations = []",
    "",
    "    if subtitles:",
    "        for idx, sub in enumerate(subtitles):",
    "            s_id = f\"sub_{idx}\"",
    "            s_start = sub[\"start\"]",
    "            s_end = sub[\"end\"]",
    "            s_dur = max(0.2, s_end - s_start)",
    "            s_text = sub[\"text\"]",
    ""
   ]
