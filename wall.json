    "\"\"\"",
    "VIDEOAI Master Pipeline",
    "Automates the complete AI Video creation cycle:",
    "  Script Text",
    "    │",
    "    ▼ (TTS Engine - Edge-TTS / gTTS / pyttsx3)",
    "  Audio Voiceover (.mp3)",
    "    │",
    "    ▼ (Whisper Engine - faster-whisper / whisper-cli)",
    "  Word-level & Subtitle Timestamps (.json / .srt)",
    "    │",
    "    ▼ (HyperFrames Engine - HTML + CSS + GSAP)",
    "  Animated Visual Composition",
    "    │",
    "    ▼ (Chrome BeginFrame Capture + FFmpeg Encoding)",
    "  Rendered Visual Video (.mp4)",
    "    │",
    "    ▼ (FFmpeg Engine - Audio Muxing & Assembly)",
    "  Final Master Video in EXPORT/",
    "\"\"\"",
    "",
    "import os",
    "import sys",
    "import time",
    "from pathlib import Path",
    "from typing import Optional, Dict, Any, List",
    "",
    "from . import tts_engine",
    "from . import transcribe_engine",
    "from . import ffmpeg_engine",
    "from . import hyperframes_engine",
    "",
    "PROJECT_ROOT = Path(__file__).parent.parent.resolve()",
    "EXPORT_DIR = PROJECT_ROOT / \"EXPORT\"",
    "RAW_FOOTAGE_DIR = PROJECT_ROOT / \"RAW FOOTAGE\"",
    "",
    "",
    "def run_full_pipeline(",
    "    script_text: str,",
    "    title: str = \"AI Video Generation\",",
    "    output_filename: str = \"final_video.mp4\",",
    "    voice: str = tts_engine.DEFAULT_VOICE,",
    "    tts_provider: str = \"edge-tts\",",
    "    whisper_model: str = \"tiny\",",
    "    theme: str = \"dark\",",
    "    background_video: Optional[str] = None",
    ") -> Dict[str, Any]:",
    "    \"\"\"",
    "    Executes the entire video creation pipeline from text script to final MP4 video.",
    "    \"\"\"",
    "    start_time = time.time()",
    "    EXPORT_DIR.mkdir(parents=True, exist_ok=True)",
    "",
    "    slug = \"\".join(c if c.isalnum() else \"_\" for c in title.lower())[:30]",
    "    work_dir = PROJECT_ROOT / \"compositions\" / f\"run_{slug}\"",
    "    work_dir.mkdir(parents=True, exist_ok=True)",
    "",
    "    audio_path = str(work_dir / \"voiceover.mp3\")",
    "    visual_video_path = str(work_dir / \"visual_only.mp4\")",
    "    final_output_path = str(EXPORT_DIR / output_filename)",
    "",
    "    print(\"\\n\" + \"=\" * 60)",
    "    print(f\"🎬 VIDEOAI ENGINE: STARTING PRODUCTION FOR '{title}'\")",
    "    print(\"=\" * 60)",
    "",
    "    # ----------------------------------------------------",
    "    # Step 1: Text-to-Speech (TTS)",
    "    # ----------------------------------------------------",
    "    print(\"\\n[Step 1/5] Synthesizing Voiceover with TTS...\")",
    "    tts_engine.synthesize("
   ]
