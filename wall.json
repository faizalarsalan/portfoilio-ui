    "        print(f\"  [✓] Whisper CLI:  {whisper_cli}\")",
    "    else:",
    "        print(f\"  [✗] Whisper CLI:  Missing at {whisper_cli}\")",
    "",
    "    tiny_model = PROJECT_ROOT / \"models\" / \"ggml-tiny.en.bin\"",
    "    base_model = PROJECT_ROOT / \"models\" / \"ggml-base.en.bin\"",
    "    print(f\"  [{'✓' if tiny_model.exists() else '✗'}] GGML Tiny Model: {tiny_model}\")",
